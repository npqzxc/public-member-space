<%- include("layout", { body: `
  <section class="panel">
    <div class="panel-head"><div><p class="eyebrow">会员协作</p><h2>会员分组列表</h2></div><form method="get"><input name="query" value="${query}" placeholder="搜索 code 或摘要" /><button type="submit">搜索</button></form></div>
    <div class="card-grid">${workspaces.map((workspace) => `<article class="card"><p class="eyebrow">${workspace.code}</p><h3><a href="/workspaces/${workspace.code}">${workspace.name}</a></h3><p>${workspace.summary}</p><div class="meta"><span>${workspace.status}</span><span>${workspace.owner}</span><span>${workspace.item_count} 项</span></div></article>`).join("")}</div>
  </section>
` }) %>
